{
  "rewrites": [
    {
      "source": "/p/(.*)",
      "destination": "/p/$1"
    }
  ],
  "headers": [
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "vite"
}